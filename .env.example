ENV=development

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nyayvault
DATABASE_URL=sqlite:///./nyayvault.db

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=250

# Comma-separated. Use "*" only for local/demo use.
CORS_ORIGINS=*

# --- Blockchain anchoring (optional, off by default) ---
# See app/utils/blockchain_anchor.py for the full design notes.
#
# Option A) Local/dev chain (Ganache, Anvil, Hardhat node) -- the original
# defaults, kept for local development:
# BLOCKCHAIN_ANCHORING_ENABLED=true
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CHAIN_ID=1337
# BLOCKCHAIN_PRIVATE_KEY=0x...
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
#
# Option B) A live public testnet, e.g. Polygon Amoy -- WEB3_PROVIDER_URI /
# WALLET_PRIVATE_KEY take priority over BLOCKCHAIN_RPC_URL /
# BLOCKCHAIN_PRIVATE_KEY above when both are set, so just use these instead:
# BLOCKCHAIN_ANCHORING_ENABLED=true
#
# RPC endpoint. Use a provider's Amoy endpoint (Alchemy, Infura, QuickNode,
# etc.) rather than the public one in production -- it's rate-limited.
# WEB3_PROVIDER_URI=https://rpc-amoy.polygon.technology
#
# Polygon Amoy's chain ID. Used both when signing transactions and to pick
# the right block-explorer link automatically (see BLOCKCHAIN_EXPLORER_BASE_URL below).
# BLOCKCHAIN_CHAIN_ID=80002
#
# Private key (hex, "0x..." or without the prefix -- both are accepted) of a
# funded test wallet dedicated to this app. NEVER a wallet holding real
# funds, and never commit a real value here -- keep it in your local .env
# (git-ignored) or a secrets manager, not this checked-in example file. Get
# free Amoy test MATIC from a faucet, e.g. https://faucet.polygon.technology/
# WALLET_PRIVATE_KEY=0x...
#
# Address HashAnchor.sol was deployed to on Amoy (deploy it once with Remix/
# Hardhat/Foundry pointed at WEB3_PROVIDER_URI above).
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
#
# Optional overrides:
# BLOCKCHAIN_GAS_LIMIT=200000
# BLOCKCHAIN_TX_TIMEOUT_SECONDS=60          # how long to wait for a tx to be mined (wait_for_receipt=True only)
# BLOCKCHAIN_RPC_TIMEOUT_SECONDS=15         # how long to wait for the RPC endpoint itself to respond
#
# Block-explorer base URL used to build a clickable link for a stored tx hash
# (shown on the document details modal). Leave unset to use the built-in
# default for BLOCKCHAIN_CHAIN_ID (80002 -> Polygonscan Amoy already works
# with no setting needed); set this explicitly for any other chain/explorer:
# BLOCKCHAIN_EXPLORER_BASE_URL=https://amoy.polygonscan.com/tx/

# --- ABAC / organisational segregation (defaults shown) ---
# ABAC_SCOPE_ATTRIBUTES=state,district,unit   # which levels must match
# ABAC_ORG_WIDE_ROLES=admin                   # roles exempt from org scoping
# ABAC_ASSIGNMENT_ROLES=io                    # roles that must also own the case
# ABAC_ROLE_DOC_TYPES={"judge": ["PDF", "VIDEO"]}   # optional per-role doc-type limits
